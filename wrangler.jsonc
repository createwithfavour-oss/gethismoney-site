{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gethismoney-site",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "gethismoney.xyz", "custom_domain": true },
    { "pattern": "www.gethismoney.xyz", "custom_domain": true }
  ],
  "assets": {
    "directory": "."
  }
}
